---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Articles</HeaderLink>
			<HeaderLink href="/about">About Us</HeaderLink>
		</div>
		<a href="https://buy.stripe.com/3cIdRb805fUj5XA4ce3ZK00" class="donate-btn" target="_blank" rel="noopener noreferrer">Donate</a>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	nav a.donate-btn {
		display: inline-block;
		justify-self: end;
		padding: 0.4em 2em;
		line-height: 1;
		background: var(--accent);
		color: white;
		border-radius: 6px;
		font-weight: 600;
		text-decoration: none;
		border-bottom: none;
		transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
	}
	nav a.donate-btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(var(--black), 20%);
		opacity: 0.9;
	}
</style>